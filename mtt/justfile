set dotenv-load := true

# List recipes
default:
  @just --list

# Preflight: local tools and Snowflake reachability
doctor connection:
  @rc=0; for t in docker openssl jq snow curl; do command -v $t >/dev/null && echo "✓ $t" || { echo "✗ $t missing"; rc=1; }; done; exit $rc
  @docker compose version >/dev/null 2>&1 && echo "✓ docker compose" || { echo "✗ docker compose missing"; exit 1; }
  @docker info >/dev/null 2>&1 && echo "✓ docker running" || { echo "✗ docker not running (or Docker Desktop needs sign-in)"; exit 1; }
  @snow sql -c {{connection}} -q "SELECT CURRENT_ACCOUNT()" >/dev/null 2>&1 && echo "✓ Snowflake reachable via '{{connection}}'" || { echo "✗ cannot reach Snowflake via '{{connection}}' (VPN? connection name?)"; exit 1; }

# One shot: every step end to end, verifying as it goes (safe to re-run)
up connection:
  bash scripts/up.sh {{connection}}

# Snowflake data model, policies, app user, semantic view, and agent
setup connection:
  snow sql -c {{connection}} -f data/migrations/001_init.sql
  snow sql -c {{connection}} -f data/migrations/002_objects.sql
  snow sql -c {{connection}} -f data/migrations/003_data.sql
  snow sql -c {{connection}} -f data/migrations/004_app.sql
  snow sql -c {{connection}} -f data/migrations/005_agent.sql

# Generate the app user's key pair locally (keys/ is gitignored)
keypair:
  mkdir -p keys
  openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out keys/app_svc.p8 -nocrypt
  openssl rsa -in keys/app_svc.p8 -pubout -out keys/app_svc.pub
  chmod 600 keys/app_svc.p8

# Register the public key on MTT_APP_SVC
set-key connection:
  snow sql -c {{connection}} --role mtt_admin -q "ALTER USER mtt_app_svc SET RSA_PUBLIC_KEY = '$(grep -v -- '-----' keys/app_svc.pub | tr -d '\n')'"

# SHA256 fingerprint of the local public key, to compare with DESC USER mtt_app_svc
fingerprint:
  @echo "SHA256:$(openssl rsa -pubin -in keys/app_svc.pub -outform DER 2>/dev/null | openssl dgst -sha256 -binary | openssl enc -base64)"

# Local IdP (human login only)
idp-up:
  docker compose up -d keycloak
  @echo "waiting for keycloak..."; until curl -sf localhost:8080/realms/master >/dev/null; do sleep 3; done; echo "✓ keycloak up"

idp-seed:
  chmod +x auth/scripts/seed.sh
  ./auth/scripts/seed.sh

app-up:
  docker compose up -d --build api web

# Onboarding is one row: just tenant-add <conn> apu kwik viewer
tenant-add connection user tenant level:
  snow sql -c {{connection}} --role mtt_admin -q "INSERT INTO mtt_db.security.entitlements VALUES ('{{user}}', 'MTT_APP_SVC', '{{tenant}}', '{{level}}')"

tenant-remove connection user:
  snow sql -c {{connection}} --role mtt_admin -q "DELETE FROM mtt_db.security.entitlements WHERE end_user_id = '{{user}}'"

# Remove everything: containers + volumes, and every Snowflake object
[confirm("Drop MTT_DB, MTT_WH, MTT_APP_SVC, MTT_APP_ROLE, MTT_ADMIN and all local containers? [y/N]")]
teardown connection:
  docker compose down -v
  snow sql -c {{connection}} -f data/teardown/teardown.sql
